{
  "name": "canvas-mindmap-danny",
  "version": "1.1.20",
  "description": "Canvas Mindmap for Obsidian",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs --production",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tests/tsconfig.json && node --test .test-build/tests/*.test.js",
    "test:ui": "tsc -p tests/tsconfig.json && node --test .test-build/tests/color-palette.test.js .test-build/tests/native-color-picker.test.js .test-build/tests/controller-native-color-picker.test.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.25.9",
    "happy-dom": "21.0.1",
    "typescript": "5.7.3"
  }
}
